# Core
API_PORT=8000
REDIS_URL=redis://redis:6379/0
DUCKDB_DB_PATH=/data/materialized_cache.duckdb
DUCKDB_THREADS=8

# Caching
CACHE_TTL_SECONDS=0
CACHE_MATERIALIZE=true
MATERIALIZE_KEEP_DAYS=0

# Security
ALLOW_ANY_URL=false
ALLOWED_PARQUET_HOSTS=digital-atlas.s3.amazonaws.com
ALLOW_S3_URLS=true
ALLOWED_S3_BUCKETS=digital-atlas
ALLOW_BROAD_GEO=false

# CORS
CORS_ORIGINS=http://localhost:4774,http://127.0.0.1:4774,http://localhost:8000,http://127.0.0.1:8000
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

PARQUET_MAGIC_CHECK=true
EXPORT_MAX_ROWS=200000


# Admin cache clear
CACHE_CLEAR_TOKEN=change-me
CACHE_CLEAR_LOCAL_ONLY=true


PARQUET_CACHE_DIR=/data/parquet_cache
PARQUET_CACHE_ENABLED=true
PARQUET_CACHE_REFRESH=false
PARQUET_DOWNLOAD_TIMEOUT_SECONDS=600
PARQUET_DOWNLOAD_LOCK_TIMEOUT_SECONDS=300